{
  "name": "rezless",
  "version": "0.1.2",
  "private": true,
  "description": "Workspace coordinator for the rezless LSL test framework (publishes @rezless/parser, @rezless/vm, @rezless/vitest).",
  "license": "Apache-2.0",
  "author": "i-doll",
  "homepage": "https://github.com/i-doll/rezless#readme",
  "bugs": {
    "url": "https://github.com/i-doll/rezless/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-doll/rezless.git"
  },
  "type": "module",
  "scripts": {
    "gen": "tsx scripts/gen-stubs.ts",
    "bump": "node scripts/bump.mjs",
    "build": "pnpm -r build",
    "prepare": "pnpm gen && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.5",
    "fast-xml-parser": "^5.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2"
}
