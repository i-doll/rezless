{
  "name": "@rezless/vitest",
  "version": "0.1.0",
  "description": "Vitest-style DSL for testing Linden Scripting Language (LSL) scripts.",
  "license": "Apache-2.0",
  "author": "i-doll",
  "homepage": "https://github.com/i-doll/rezless#readme",
  "bugs": {
    "url": "https://github.com/i-doll/rezless/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-doll/rezless.git",
    "directory": "packages/vitest"
  },
  "keywords": [
    "lsl",
    "linden-scripting-language",
    "second-life",
    "vitest",
    "testing",
    "test-framework",
    "rezless"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "import": "./dist/reporter.js"
    },
    "./coverage-setup": {
      "types": "./dist/coverage-setup.d.ts",
      "import": "./dist/coverage-setup.js"
    }
  },
  "bin": {
    "rezless-coverage": "./dist/cli.js"
  },
  "files": ["dist", "LICENSE", "NOTICE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rezless/parser": "workspace:*",
    "@rezless/vm": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^4.1.5"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
