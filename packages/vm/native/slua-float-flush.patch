+// rezless: Second Life's arithmetic, and its conversion of a number to a float, turn a
+// result below the smallest normal float or double into a zero of the same sign. A tiny
+// operand is used as it is, and a float read from a string keeps its value.
+inline float luai_ftzf(float v)
+{
+    return fabsf(v) < FLT_MIN ? copysignf(0.0f, v) : v;
+}
+
+inline double luai_ftz(double v)
+{
+    return fabs(v) < DBL_MIN ? copysign(0.0, v) : v;
+}
+
+inline float luai_mulf(float a, float b)
+{
+    return luai_ftzf(a * b);
+}
+
+inline float luai_addf(float a, float b)
+{
+    return luai_ftzf(a + b);
+}
+
+inline float luai_subf(float a, float b)
+{
+    return luai_ftzf(a - b);
+}
+
+inline float luai_dot3f(const float* a, const float* b)
+{
+    return luai_addf(luai_addf(luai_mulf(a[0], b[0]), luai_mulf(a[1], b[1])), luai_mulf(a[2], b[2]));
+}
+
+inline float luai_dot4f(const float* a, const float* b)
+{
+    return luai_addf(luai_dot3f(a, b), luai_mulf(a[3], b[3]));
+}
