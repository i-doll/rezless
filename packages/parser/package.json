{
  "name": "@rezless/parser",
  "version": "0.1.0",
  "description": "Recursive-descent parser for the Linden Scripting Language (LSL).",
  "license": "Apache-2.0",
  "author": "i-doll",
  "homepage": "https://github.com/i-doll/rezless#readme",
  "bugs": {
    "url": "https://github.com/i-doll/rezless/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-doll/rezless.git",
    "directory": "packages/parser"
  },
  "keywords": [
    "lsl",
    "linden-scripting-language",
    "second-life",
    "parser",
    "rezless"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "NOTICE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
